{
    "name": "finget/laravel",
    "description": "Official Laravel package for Finget passwordless login and notifications",
    "type": "library",
    "license": "MIT",
    "keywords": ["finget", "laravel", "login", "otp", "passwordless", "notifications", "iran"],
    "homepage": "https://finget.ir/plugins",
    "support": {
        "docs": "https://finget.ir/provider/panel/docs",
        "issues": "https://github.com/amirsafaridevs/finget-laravel/issues",
        "source": "https://github.com/amirsafaridevs/finget-laravel"
    },
    "authors": [
        {
            "name": "Finget",
            "homepage": "https://finget.ir"
        }
    ],
    "require": {
        "php": "^8.1",
        "finget/sdk": "^1.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/session": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Finget\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Finget\\Laravel\\FingetServiceProvider"
            ],
            "aliases": {
                "Finget": "Finget\\Laravel\\Facades\\Finget"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
